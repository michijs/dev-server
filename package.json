{
  "name": "@michijs/dev-server",
  "license": "MIT",
  "version": "0.8.30-beta.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/michijs/dev-server.git"
  },
  "types": "./bin/index.d.ts",
  "exports": {
    ".": {
      "types": "./bin/index.d.ts"
    },
    "./constants": {
      "types": "./bin/constants.d.ts"
    }
  },
  "bin": {
    "michi-server": "bin/michi-server.mjs"
  },
  "description": "Development server based on esbuild, distributed as standalone Bun executables",
  "files": [
    "bin/"
  ],
  "type": "module",
  "baseUrl": "./src",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "types": "tsc --emitDeclarationOnly --outDir bin",
    "types-w": "tsc --emitDeclarationOnly --outDir bin -w",
    "bun-link": "bun link --force",
    "link": "bun run --parallel types-w bun-link"
  },
  "devDependencies": {
    "@michijs/shared-configs": "0.0.37",
    "@types/bun": "1.3.13",
    "@types/node": "25.5.0",
    "@types/yargs": "17.0.35",
    "typescript": "5.9.3"
  },
  "keywords": [
    "react",
    "javascript",
    "css",
    "bundler",
    "typescript",
    "compiler",
    "jsx",
    "commonjs",
    "minifier",
    "tsx",
    "esm",
    "server",
    "development"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/chrome": "^0.1.38",
    "colorthief": "3.3.1",
    "@types/web-app-manifest": "1.0.9",
    "esbuild": "0.27.4",
    "node-watch": "0.7.4",
    "open": "11.0.0",
    "playwright-core": "1.58.2",
    "yargs": "18.0.0"
  }
}
